# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# auto | gemini | groq | openrouter | openai | mock
REVIEW_PROVIDER=auto

# Database (SQLite for local; use Postgres URL on Vercel)
# Prisma CLI resolves this relative to the prisma/ folder
DATABASE_URL=file:./dev.db

# Better Auth (generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
