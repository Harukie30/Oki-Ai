# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# auto | gemini | groq | openrouter | openai | mock
REVIEW_PROVIDER=auto

# Database
# Local: SQLite (Prisma CLI resolves this relative to the prisma/ folder)
DATABASE_URL=file:./dev.db
# Vercel: use a hosted Postgres URL (Neon/Supabase). SQLite will not persist on serverless.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth (generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
# Local:
BETTER_AUTH_URL=http://localhost:3000
# Vercel: set to your deployment URL, e.g. https://oki-ai.vercel.app
