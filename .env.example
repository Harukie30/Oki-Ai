# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended: fast Flash-Lite. Fallbacks try others if unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional default when the UI doesn’t send a provider — auto | gemini | groq | mock
REVIEW_PROVIDER=auto

# Groq (used when Review model = Groq)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
